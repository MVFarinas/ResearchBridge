# Copy to .env and fill in what you need. Never commit .env.
# Every key below is optional: code must degrade gracefully when it is unset.

# --- Local Postgres (docker compose) ---
# Host port the pgvector container listens on (default 5433).
RB_DB_PORT=5433
# Local-development-only credentials for the compose database.
RB_DB_NAME=researchbridge
RB_DB_USER=researchbridge
RB_DB_PASSWORD=researchbridge-dev-only

# --- Django backend (backend/) ---
# Development only: with DJANGO_DEBUG=true and no key, a fixed insecure key is used.
DJANGO_DEBUG=true
# Required whenever DJANGO_DEBUG is false. Generate one; never commit it.
DJANGO_SECRET_KEY=
# Comma-separated; defaults to localhost when debugging.
DJANGO_ALLOWED_HOSTS=
# Comma-separated origins (scheme + host) trusted for CSRF, e.g. https://example.org.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Redirect HTTP to HTTPS (set true on the hosting platform once TLS is in place).
DJANGO_SECURE_SSL_REDIRECT=false
# Believe X-Forwarded-Proto. Set true ONLY behind a platform proxy (Render, Railway) that
# sets it; if the app is reachable directly, any client could claim HTTPS with it.
DJANGO_TRUST_PROXY_SSL_HEADER=false
# Where collectstatic writes the admin's static files (default backend/staticfiles;
# the Docker image uses /app/staticfiles).
DJANGO_STATIC_ROOT=
# Managed platforms set DATABASE_URL (postgres://user:password@host:port/name); it wins over
# the RB_DB_* settings above. Leave unset locally.
DATABASE_URL=
# Host of the local database (default 127.0.0.1).
RB_DB_HOST=
# Seconds to keep database connections open between requests (0 closes them each time).
RB_DB_CONN_MAX_AGE=0
# Root log level for the backend and worker (DEBUG, INFO, WARNING, ...).
RB_LOG_LEVEL=INFO
# The worker re-checks stored PMC articles not checked for this many days (default 7),
# at most this many per daily run (default 500). Keeping data current is a PMC bucket term.
RB_RECHECK_MAX_AGE_DAYS=7
RB_RECHECK_BATCH_SIZE=500

# --- Reader API (backend/, Phases 4-5) ---
# Hours a cached OpenAlex / iCite / Crossref / ID-converter answer stays fresh (default 168),
# and an OpenAlex search (default 24). Stale answers are served, with their date, if a refresh fails.
RB_METADATA_TTL_HOURS=168
RB_SEARCH_TTL_HOURS=24
# Papers on-demand lookups may queue for ingestion per UTC day (default 100).
RB_LOOKUP_DAILY_INGEST_LIMIT=100
# Per-client-address rate limits (DRF syntax: N/sec, N/min, N/hour, N/day).
RB_API_RATE_SEARCH=30/min
RB_API_RATE_PAPERS=120/min
RB_API_RATE_CREDIBILITY=60/min
RB_API_RATE_LOOKUP=10/min
RB_API_RATE_LOOKUP_STATUS=120/min
# Proxies in front of the API whose X-Forwarded-For entries are trusted for the client
# address (default 0: use the socket address). Set it only when the API is reachable
# solely through those proxies (e.g. 1 behind the web server), or clients can spoof it.
RB_API_NUM_PROXIES=0

# --- Web app (web/, Phases 4-5) ---
# Where the Next.js server reaches the backend API (server-side only; never sent to browsers).
RB_API_URL=http://127.0.0.1:8000
# Public origin of the web app, for canonical links and the sitemap (no trailing slash).
RB_SITE_URL=http://localhost:3000

# --- LLM (Claude API) ---
# Read by rbcore.config. Without a key, only the deterministic fake client is available.
ANTHROPIC_API_KEY=
# Model IDs live in configuration, never in code (decisions.md §1.6).
# The generation model is chosen by the Phase 1 benchmark (decisions.md §1.4).
RB_LLM_GENERATION_MODEL=
# The judge model must differ from the generation model (decisions.md §1.4).
RB_LLM_JUDGE_MODEL=

# --- Scholarly metadata (optional) ---
# OpenAlex works without a key on a small daily allowance; a free key raises it.
OPENALEX_API_KEY=
# NCBI E-utilities: without a key, at most 3 requests per second.
NCBI_API_KEY=

# --- Local data directory for downloads and caches (gitignored) ---
RB_DATA_DIR=data
