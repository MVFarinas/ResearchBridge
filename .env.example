# Copy to .env and fill in what you need. Never commit .env.
# Every key below is optional: code must degrade gracefully when it is unset.

# --- Local Postgres (docker compose) ---
# Host port the pgvector container listens on (default 5433).
RB_DB_PORT=5433
# Local-development-only credentials for the compose database.
RB_DB_NAME=researchbridge
RB_DB_USER=researchbridge
RB_DB_PASSWORD=researchbridge-dev-only

# --- Django backend (backend/) ---
# Development only: with DJANGO_DEBUG=true and no key, a fixed insecure key is used.
DJANGO_DEBUG=true
# Required whenever DJANGO_DEBUG is false. Generate one; never commit it.
DJANGO_SECRET_KEY=
# Comma-separated; defaults to localhost when debugging.
DJANGO_ALLOWED_HOSTS=
# Managed platforms set DATABASE_URL (postgres://user:password@host:port/name); it wins over
# the RB_DB_* settings above. Leave unset locally.
DATABASE_URL=
# Host of the local database (default 127.0.0.1).
RB_DB_HOST=
# The worker re-checks stored PMC articles not checked for this many days (default 7),
# at most this many per daily run (default 500). Keeping data current is a PMC bucket term.
RB_RECHECK_MAX_AGE_DAYS=7
RB_RECHECK_BATCH_SIZE=500

# --- LLM (Claude API) ---
# Read by rbcore.config. Without a key, only the deterministic fake client is available.
ANTHROPIC_API_KEY=
# Model IDs live in configuration, never in code (decisions.md §1.6).
# The generation model is chosen by the Phase 1 benchmark (decisions.md §1.4).
RB_LLM_GENERATION_MODEL=
# The judge model must differ from the generation model (decisions.md §1.4).
RB_LLM_JUDGE_MODEL=

# --- Scholarly metadata (optional) ---
# OpenAlex works without a key on a small daily allowance; a free key raises it.
OPENALEX_API_KEY=
# NCBI E-utilities: without a key, at most 3 requests per second.
NCBI_API_KEY=

# --- Local data directory for downloads and caches (gitignored) ---
RB_DATA_DIR=data
