# ResearchBridge developer entry points. Run `make help` for the list.
#
# Python packages are discovered, not listed: any directory one level down
# (or under libs/) with a pyproject.toml is a package. A later phase adds its
# package directory, runs `make lock`, and every target below picks it up.

SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := help

PYTHON ?= python3.12
VENV := $(CURDIR)/.venv
BIN := $(VENV)/bin

# Discover Python packages (third_party only ever holds licence texts).
PY_PACKAGES := $(sort $(filter-out third_party/%,$(patsubst %/pyproject.toml,%,$(wildcard libs/*/pyproject.toml */pyproject.toml))))
# Packages opt into mypy by having a [tool.mypy] section in their pyproject.toml.
MYPY_PACKAGES := $(sort $(foreach p,$(PY_PACKAGES),$(if $(shell grep -l '^\[tool\.mypy\]' $(p)/pyproject.toml),$(p))))
# The web job only exists once web/package.json does (Phase 4).
WEB := $(wildcard web/package.json)

# Docker compose settings for the local pgvector database.
COMPOSE_PROJECT ?= researchbridge
COMPOSE := docker compose -p $(COMPOSE_PROJECT)

.PHONY: help setup lock lint format typecheck test check packages db-up db-down

help: ## Show this help.
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-10s %s\n", $$1, $$2}'

packages: ## List the discovered Python packages.
	@echo "Python packages: $(PY_PACKAGES)"
	@echo "Type-checked:    $(MYPY_PACKAGES)"
	@echo "Web:             $(if $(WEB),web,none)"

setup: ## Create .venv and install the locked dev environment (and web deps if present).
	@test -x $(BIN)/python || $(PYTHON) -m venv $(VENV)
	$(BIN)/python -m pip install --quiet --upgrade pip
	$(BIN)/python -m pip install --quiet -r requirements/dev.txt
ifneq ($(WEB),)
	npm --prefix web ci
endif

lock: ## Regenerate requirements/packages.in and recompile requirements/dev.txt.
	@{ echo "# Generated by \`make lock\`: one editable line per discovered package. Do not edit."; \
	  for p in $(PY_PACKAGES); do echo "-e file:$$p"; done; } > requirements/packages.in
	$(BIN)/pip-compile --quiet --strip-extras --allow-unsafe --no-emit-index-url \
	  --output-file requirements/dev.txt requirements/dev.in requirements/packages.in

lint: ## Ruff lint and format check, docstring coverage, lock coverage (and web lint).
	$(BIN)/ruff check .
	$(BIN)/ruff format --check .
	$(BIN)/rb-check-docstrings $(PY_PACKAGES)
	$(BIN)/rb-check-lock --lock requirements/dev.txt $(PY_PACKAGES)
ifneq ($(WEB),)
	npm --prefix web run lint
endif

format: ## Apply ruff formatting and safe autofixes.
	$(BIN)/ruff format .
	$(BIN)/ruff check --fix .

# The loops end with `|| exit 1` because macOS ships GNU Make 3.81, which ignores
# .SHELLFLAGS: without it a failing package other than the last would not fail the target.
typecheck: ## mypy for every package with a [tool.mypy] section (and web tsc).
	@for p in $(MYPY_PACKAGES); do echo "mypy: $$p"; (cd $$p && $(BIN)/mypy) || exit 1; done
ifneq ($(WEB),)
	npm --prefix web run typecheck
endif

test: ## pytest in every Python package (and web tests).
	@for p in $(PY_PACKAGES); do echo "pytest: $$p"; (cd $$p && $(BIN)/pytest -q) || exit 1; done
ifneq ($(WEB),)
	npm --prefix web test
endif

check: lint typecheck test ## Everything CI runs.

db-up: ## Start the local pgvector database (port from RB_DB_PORT, default 5433).
	$(COMPOSE) up -d --wait db

db-down: ## Stop the local database (data stays in the named volume).
	$(COMPOSE) down
